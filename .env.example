# Home Assistant API configuration
# Your Home Assistant instance URL (e.g. http://homeassistant.local:8123 or http://192.168.1.50:8123)
# Not needed when running as a Home Assistant add-on (Supervisor API is used automatically).
HA_URL=http://homeassistant.local:8123

# Long-Lived Access Token
# Created from your Home Assistant profile > Security > Long-Lived Access Tokens
# Not needed when running as a Home Assistant add-on.
HA_TOKEN=

# Authentication token signing secret (optional)
# HS256 key used to sign access/refresh tokens. Must be at least 32 bytes.
# Leave empty to auto-generate a secret on first boot and persist it in the database.
# Keep it stable: changing it invalidates every existing access/refresh token.
TOKEN_SECRET=

# Key-encryption key (optional, recommended)
# A 32-byte key (exactly 32 ASCII characters) used to envelope-encrypt (AES-256-GCM) the
# auto-generated JWT signing secret before it is written to the database. With it set, a
# copy of the database or a Home Assistant snapshot no longer exposes the signing key.
# Store it in your secret manager, not in the repository. Losing it makes the stored
# signing secret unrecoverable (users must re-enroll), so keep it stable and backed up.
# SECRET_KEY=

# Trusted origins for CSRF and same-origin checks (optional)
# Comma-separated. Only needed when a reverse proxy rewrites the Host header:
# set it to the browser-facing origin(s) of this Walldash instance.
# Both https://walldash.example.com and the bare host walldash.example.com are accepted.
# ALLOWED_ORIGINS=https://walldash.example.com

# Public hostname of this Walldash instance (optional)
# Used for the CORS Access-Control-Allow-Origin header and the CSRF/same-origin checks.
# Accepts a bare host, http://host or https://host; an optional port is kept and any
# path/query is ignored. Merged with ALLOWED_ORIGINS. Equivalent to the add-on `domain` option.
# DOMAIN=walldash.example.com

# HTTPS is required: authentication cookies use the __Host- + Secure prefix.
# Browsers silently drop them over plain HTTP, which causes a login loop.
# Terminate TLS in a reverse proxy in front of Walldash (see docs/reverse-proxy.md)
# and make sure the proxy forwards X-Forwarded-Proto: https.

# Server configuration
PORT=8080
DB_PATH=walldash.db

# Log level: debug, info, warn, error
LOG_LEVEL=info

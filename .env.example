# Home Assistant API configuration
# Your Home Assistant instance URL (e.g. http://homeassistant.local:8123 or http://192.168.1.50:8123)
# Not needed when running as a Home Assistant add-on (Supervisor API is used automatically).
HA_URL=http://homeassistant.local:8123

# Long-Lived Access Token
# Created from your Home Assistant profile > Security > Long-Lived Access Tokens
# Not needed when running as a Home Assistant add-on.
HA_TOKEN=

# Authentication token signing secret (optional)
# HS256 key used to sign access/refresh tokens. Must be at least 32 bytes.
# Leave empty to auto-generate a secret on first boot and persist it in the database.
# Keep it stable: changing it signs out every device.
# Add-on equivalent: the `token_secret` option.
TOKEN_SECRET=

# Key-encryption key (optional, recommended)
# A 32-byte key (exactly 32 ASCII characters) used to envelope-encrypt (AES-256-GCM) the
# auto-generated JWT signing secret before it is written to the database.
# SECRET_KEY is the inline value and wins over SECRET_KEY_FILE.
# Store it in your secret manager, not in the repository. Removing it after it has been
# used fails closed (the server refuses to start), so keep it stable and backed up.
# Add-on equivalent: the `secret_key` option.
# SECRET_KEY=

# Key-encryption key file (optional, stronger choice for backups)
# Path to a file whose whitespace-trimmed contents are the 32-byte key-encryption key.
# Prefer this over SECRET_KEY when the database lives in a snapshot-backed volume (for
# example the Home Assistant add-on /data volume): point it at an operator-mounted path
# that is excluded from backups. An unreadable or empty file aborts startup.
# Ignored when SECRET_KEY is set.
# Add-on equivalent: the `secret_key_file` option.
# SECRET_KEY_FILE=

# With no TOKEN_SECRET and no key-encryption key configured, Walldash generates a KEK in
# <DB_PATH>.kek (mode 0600) and seals the signing key with it. That file travels with full
# /data snapshots next to the database, so treat snapshots as secrets; to protect keys that
# leave the host, set TOKEN_SECRET or point SECRET_KEY_FILE outside the snapshot. If the KEK
# file is lost, set TOKEN_SECRET to start again (this signs out every device).

# Rescue mode (optional)
# When true, the next device that opens Walldash claims the owner role even if other
# devices already exist. Use it only to recover from a lost owner device, then set it back
# to false: it is consumed after a single use and a restart re-arms it.
# Add-on equivalent: the `rescue_mode` option.
RESCUE_MODE=false

# Trusted origins for CSRF and same-origin checks (optional)
# Comma-separated. Only needed when a reverse proxy rewrites the Host header:
# set it to the browser-facing origin(s) of this Walldash instance.
# Both https://walldash.example.com and the bare host walldash.example.com are accepted.
# Add-on equivalent: the `allowed_origins` option.
# ALLOWED_ORIGINS=https://walldash.example.com

# Public hostname of this Walldash instance (optional)
# Used for the CORS Access-Control-Allow-Origin header and the CSRF/same-origin checks.
# Accepts a bare host, http://host or https://host; an optional port is kept and any
# path/query is ignored. Merged with ALLOWED_ORIGINS. Equivalent to the add-on `domain` option.
# DOMAIN=walldash.example.com

# HTTPS is required: authentication cookies use the __Host- + Secure prefix.
# Browsers silently drop them over plain HTTP, which causes a login loop.
# Terminate TLS in a reverse proxy in front of Walldash (see docs/reverse-proxy.md)
# and make sure the proxy forwards X-Forwarded-Proto: https.

# Server configuration
PORT=8080
DB_PATH=walldash.db

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Home Assistant API configuration
# URL de votre instance Home Assistant (ex: http://homeassistant.local:8123 ou http://192.168.1.50:8123)
HA_URL=http://homeassistant.local:8123

# Jeton d'accès longue durée (Long-Lived Access Token)
# Créé depuis votre profil Home Assistant > Sécurité > Jetons d'accès longue durée
HA_TOKEN=

# Configuration du serveur
PORT=8080
DB_PATH=ha-dash.db
